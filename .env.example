# Example environment for local runs. Copy to `.env` (git-ignored) or export the values,
# then start the site:  python -m Website.app
#
# On Render these are set under the service's "Environment Variables" section instead --
# a `.env` file is never deployed. Everything below is optional; the defaults are what
# development uses, so an empty environment is a valid configuration.
#
# The app requires NO API keys and NO secrets.

# --- server ------------------------------------------------------------------
# Render injects PORT automatically; locally the defaults are:
HOST=127.0.0.1
PORT=5000
LOG_LEVEL=INFO
# FLASK_DEBUG=1            # never enable in production

# Optional. Only required if Flask sessions are added later; the site runs without it.
# SECRET_KEY=

# --- paths (relative values resolve against the repository root) -------------
MODELS_DIR=Models
METRICS_PATH=Evaluation/metrics/metrics.json
UPLOAD_DIR=Website/static/uploads

# --- upload policy ------------------------------------------------------------
MAX_UPLOAD_MB=8
MAX_IMAGE_PIXELS=40000000
MIN_IMAGE_SIDE=64
UPLOAD_TTL_SECONDS=3600
